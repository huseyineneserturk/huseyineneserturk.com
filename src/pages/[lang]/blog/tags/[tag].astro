---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostCard from "@/components/PostCard.astro";
import { getBlogPosts, getAllTags } from "@/lib/content";
import { languages, useTranslations, type Lang } from "@/i18n/ui";
import readingTime from "reading-time";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages) as Lang[]) {
    const tags = await getAllTags(lang);
    for (const { tag } of tags) {
      paths.push({ params: { lang, tag }, props: { tag } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { tag } = Astro.props;
const t = useTranslations(lang);
const posts = (await getBlogPosts(lang)).filter((p) => p.data.tags.includes(tag));
const rt = (post: (typeof posts)[number]) =>
  Math.max(1, Math.round(readingTime(post.body ?? "").minutes));
---

<BaseLayout
  lang={lang}
  title={`#${tag} — ${t("blog.title")}`}
  description={`${t("blog.tagged")}: ${tag}`}
>
  <a href={`/${lang}/blog`} class="rune back">← {t("blog.allPosts")}</a>
  <PageHeader eyebrow={t("blog.tagged")} title={`#${tag}`} />

  <div class="list">
    {posts.map((post) => <PostCard post={post} lang={lang} readingTime={rt(post)} />)}
  </div>
</BaseLayout>

<style>
  .back { display: inline-block; color: var(--gold); margin-bottom: 1.5rem; }
  .back:hover { color: var(--gold-bright); }
  .list { display: grid; gap: 1.1rem; }
  @media (min-width: 720px) { .list { grid-template-columns: repeat(2, 1fr); } }
</style>
