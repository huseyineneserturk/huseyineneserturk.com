---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { langStaticPaths } from "@/lib/paths";
import { useTranslations, type Lang } from "@/i18n/ui";
import { bio, skills, timeline } from "@/data/about";

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// **kalın** vurguyu basit biçimde işle
const renderBold = (s: string) =>
  s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<BaseLayout
  lang={lang}
  title={`${t("about.title")} — ${t("site.title")}`}
  description={t("site.role")}
>
  <PageHeader title={t("about.title")} subtitle={t("site.role")} />

  <section class="bio">
    {bio[lang].map((p, i) => (
      <p class:list={["para", { dropcap: i === 0 }]} set:html={renderBold(p)} />
    ))}
  </section>

  <section class="block">
    <h2 class="sec-title">{t("about.stack")}</h2>
    <div class="skills">
      {skills.map((group) => (
        <div class="skill-group illuminated">
          <p class="rune group-label">{group.label[lang]}</p>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <h2 class="sec-title">{t("about.timeline")}</h2>
    <ol class="timeline">
      {timeline.map((entry) => (
        <li>
          <span class="year rune">{entry.year}</span>
          <div class="node" aria-hidden="true"></div>
          <div class="entry">
            <h3>{entry.title[lang]}</h3>
            <p>{entry.detail[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .bio { max-width: 44rem; }
  .bio .para { font-size: 1.12rem; line-height: 1.8; color: var(--ink-soft); margin-bottom: 1.2rem; }
  .bio .para :global(strong) { color: var(--gold-bright); }
  .bio .dropcap::first-letter {
    font-family: var(--font-deco);
    font-size: 3.2em;
    line-height: 0.72;
    float: left;
    margin: 0.05em 0.1em 0 0;
    color: var(--crimson);
  }

  .block { margin-top: 3.5rem; }
  .sec-title { font-size: 1.6rem; margin-bottom: 1.4rem; display: flex; align-items: center; gap: 0.6rem; }
  .sec-title .rune { color: var(--gold); font-size: 1.2rem; }

  .skills { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .skill-group { padding: 1.2rem; }
  .group-label { color: var(--gold); margin-bottom: 0.8rem; }
  .skill-group ul { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; }
  .skill-group li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--circuit);
    border: 1px solid var(--line-strong);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-seal);
  }

  .timeline { list-style: none; position: relative; padding-left: 1.5rem; }
  .timeline::before {
    content: "";
    position: absolute;
    left: 5.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(var(--gold), var(--circuit));
    opacity: 0.4;
  }
  .timeline li { display: grid; grid-template-columns: 4rem 1.5rem 1fr; gap: 0.5rem; margin-bottom: 1.8rem; align-items: start; }
  .timeline .year { color: var(--gold); padding-top: 0.2rem; }
  .timeline .node {
    width: 11px; height: 11px;
    margin-top: 0.35rem;
    border: 2px solid var(--gold);
    background: var(--bg);
    border-radius: 50%;
    transform: translateX(0.2rem);
  }
  .timeline .entry h3 { font-size: 1.15rem; margin-bottom: 0.3rem; }
  .timeline .entry p { color: var(--ink-soft); font-size: 0.98rem; }

  @media (max-width: 560px) {
    .timeline { padding-left: 0; }
    .timeline::before { left: 4.4rem; }
    .timeline li { grid-template-columns: 3.4rem 1.2rem 1fr; }
  }
</style>
