---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { langStaticPaths } from "@/lib/paths";
import { useTranslations, type Lang } from "@/i18n/ui";

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const channels = [
  { label: "E-posta", value: "huseyineneserturk@gmail.com", href: "mailto:huseyineneserturk@gmail.com", glyph: "✉" },
  { label: "GitHub", value: "github.com/huseyineneserturk", href: "https://github.com/huseyineneserturk", glyph: "</>" },
  { label: "LinkedIn", value: "in/huseyin-enes-erturk", href: "https://www.linkedin.com/in/huseyin-enes-erturk/", glyph: "in" },
  { label: "Dev.to", value: "dev.to/huseyineneserturk", href: "https://dev.to/huseyineneserturk", glyph: "✍" },
  { label: "LeetCode", value: "leetcode.com/huseyineneserturk", href: "https://leetcode.com/huseyineneserturk", glyph: "⚇" },
];
---

<BaseLayout
  lang={lang}
  title={`${t("contact.title")} — ${t("site.title")}`}
  description={t("contact.subtitle")}
>
  <PageHeader eyebrow="EPISTVLA" title={t("contact.title")} subtitle={t("contact.subtitle")} />

  <div class="channels">
    {channels.map((c) => (
      <a class="channel illuminated glow-hover" href={c.href} target={c.href.startsWith("mailto") ? undefined : "_blank"} rel="noopener noreferrer">
        <span class="glyph" aria-hidden="true">{c.glyph}</span>
        <span class="text">
          <span class="rune label">{c.label}</span>
          <span class="value">{c.value}</span>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .channels { display: grid; gap: 1rem; max-width: 38rem; }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
  }
  .glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px; height: 42px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--gold-bright);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-seal);
  }
  .text { display: flex; flex-direction: column; line-height: 1.3; flex: 1; }
  .label { color: var(--gold); }
  .value { font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-soft); margin-top: 0.15rem; }
  .arrow { color: var(--gold); transition: transform 0.2s ease; }
  .channel:hover .arrow { transform: translateX(4px); color: var(--gold-bright); }
</style>
