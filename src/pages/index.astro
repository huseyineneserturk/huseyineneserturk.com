---
// Kök URL → tarayıcı diline göre TR/EN'e yönlendir.
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hüseyin Enes Ertürk — Codex</title>
    <link rel="canonical" href="https://huseyineneserturk.com/tr/" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      const lang = (navigator.language || "tr").toLowerCase().startsWith("en")
        ? "en"
        : "tr";
      window.location.replace("/" + lang + "/");
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/tr/" /></noscript>
  </head>
  <body>
    <p style="font-family: serif; padding: 2rem;">
      Yönlendiriliyor… / Redirecting…
      <a href="/tr/">Türkçe</a> · <a href="/en/">English</a>
    </p>
  </body>
</html>
