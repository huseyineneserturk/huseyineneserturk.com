---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import GoldDust from "@/components/GoldDust.astro";
import type { Lang } from "@/i18n/ui";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  type?: "website" | "article";
}

const { title, description, lang, image, type } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} image={image} type={type} />
    <ClientRouter />
  </head>
  <body>
    <GoldDust />
    <a href="#main" class="skip-link">İçeriğe geç / Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <button id="to-top" class="to-top" aria-label={lang === "tr" ? "Başa dön" : "Back to top"}>↑</button>

    <script>
      import "@/scripts/fx";
    </script>

    <style>
      main { max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.5rem 0; }
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 100;
        background: var(--gold);
        color: var(--bg-deep);
        padding: 0.6rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }
      .skip-link:focus { left: 0.5rem; top: 0.5rem; }

      /* Mum mührü "başa dön" butonu */
      .to-top {
        position: fixed;
        right: 1.2rem;
        bottom: 1.2rem;
        z-index: 70;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 1px solid var(--gold-bright);
        background: radial-gradient(circle at 35% 30%, var(--gold-bright), var(--gold) 75%);
        color: var(--bg-deep);
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        cursor: pointer;
        opacity: 0;
        transform: translateY(14px);
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow:
          0 8px 20px -8px #000000a8,
          0 0 16px -4px color-mix(in srgb, var(--gold) 60%, transparent);
      }
      .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
      .to-top:hover {
        transform: translateY(-3px);
        box-shadow:
          0 12px 26px -10px #000000a8,
          0 0 24px -4px color-mix(in srgb, var(--gold) 80%, transparent);
      }
    </style>
  </body>
</html>
